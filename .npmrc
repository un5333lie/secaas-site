# SeelieSec npm Security Configuration
# Hardens npm behavior to reduce supply chain attack surface

# Enforce lock file usage — prevent accidental dependency mutations
package-lock=true

# Prevent npm install scripts from executing automatically
# Mitigates: malicious postinstall scripts (common supply chain attack vector)
# Note: Some packages may require manual script execution after install
ignore-scripts=true

# Use exact versions by default (no ^ or ~ prefixes)
# Prevents unintended minor/patch upgrades that could introduce compromised code
save-exact=true

# Audit on every install
audit=true
audit-level=high

# Enforce the package.json "engines" range — fail the install on an
# unsupported Node version instead of warning
engine-strict=true

# trigger verification — this branch is throwaway, do not merge
